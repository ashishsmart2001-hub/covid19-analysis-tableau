      <aliases enabled='yes' />
      <column caption='Asthma' datatype='integer' name='[ASTHMA]' role='measure' type='quantitative' />
      <column caption='Cardiovascular' datatype='integer' name='[CARDIOVASCULAR]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Clasiffication Final' datatype='integer' name='[CLASIFFICATION_FINAL]' role='dimension' type='ordinal' />
      <column caption='Copd' datatype='integer' name='[COPD]' role='measure' type='quantitative' />
      <column caption='Pneumonia Rate' datatype='real' name='[Calculation_1062005129020207105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [PNEUMONIA]=1 THEN 1 ELSE 0 END) &#13;&#10;/ &#13;&#10;COUNT(IF [PNEUMONIA]&lt;=2 THEN [PNEUMONIA] END)' />
      </column>
      <column caption='COVID Case' datatype='string' name='[Calculation_1266355961487556610]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CLASIFFICATION_FINAL] = 1&#13;&#10;OR [CLASIFFICATION_FINAL] = 2&#13;&#10;OR [CLASIFFICATION_FINAL] = 3&#13;&#10;THEN &quot;COVID Case&quot;&#13;&#10;ELSE &quot;Not COVID&quot;&#13;&#10;END' />
      </column>
      <column caption='Death Status' datatype='string' name='[Calculation_1266355961489104899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DATE_DIED] = &quot;9999-99-99&quot; THEN &quot;Not Died&quot;&#13;&#10;ELSE &quot;Died&quot;&#13;&#10;END' />
      </column>
      <column caption='Total COVID Cases' datatype='integer' name='[Calculation_1266355961489690628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1266355961487556610] = &quot;COVID Case&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Total Deaths' datatype='integer' name='[Calculation_1266355961490292741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1266355961489104899] = &quot;Died&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Death Rate %' datatype='real' default-format='p0.00%' name='[Calculation_1266355961490759686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1266355961490292741] / [Calculation_1266355961489690628]' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_4418312750767013889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [AGE] &lt;= 18 THEN &quot;0-18&quot;&#13;&#10;ELSEIF [AGE] &lt;= 30 THEN &quot;19-30&quot;&#13;&#10;ELSEIF [AGE] &lt;= 45 THEN &quot;31-45&quot;&#13;&#10;ELSEIF [AGE] &lt;= 60 THEN &quot;46-60&quot;&#13;&#10;ELSE &quot;61+&quot;&#13;&#10;END' />
      </column>
      <column caption='Sex Group' datatype='string' name='[Calculation_5297922053159292928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SEX] = 1 THEN &quot;Female&quot;&#13;&#10;ELSEIF [SEX] = 2 THEN &quot;Male&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Death Date Clean' datatype='date' name='[Calculation_5297922053162491905]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [DATE_DIED] = &quot;9999-99-99&quot; THEN NULL&#13;&#10;ELSE DATE(DATEPARSE(&quot;MM/dd/yyyy&quot;, [DATE_DIED]))&#13;&#10;END' />
      </column>
      <column caption='Pneumonia Group' datatype='string' name='[Calculation_5297922053162815490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PNEUMONIA] = 1 THEN &quot;Yes&quot;&#13;&#10;ELSEIF [PNEUMONIA] = 2 THEN &quot;No&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Diabetes Group' datatype='string' name='[Calculation_5297922053163053059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DIABETES] = 1 THEN &quot;Yes&quot;&#13;&#10;ELSEIF [DIABETES] = 2 THEN &quot;No&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Hypertension Group' datatype='string' name='[Calculation_5297922053163298820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [HIPERTENSION] = 1 THEN &quot;Yes&quot;&#13;&#10;ELSEIF [HIPERTENSION] = 2 THEN &quot;No&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Obesity Group' datatype='string' name='[Calculation_5297922053163651077]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [OBESITY] = 1 THEN &quot;Yes&quot;&#13;&#10;ELSEIF [OBESITY] = 2 THEN &quot;No&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='ICU Group' datatype='string' name='[Calculation_5297922053163732998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ICU] = 1 THEN &quot;Yes&quot;&#13;&#10;ELSEIF [ICU] = 2 THEN &quot;No&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Patient Type Group' datatype='string' name='[Calculation_5297922053163843591]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PATIENT_TYPE] = 1 THEN &quot;Outpatient&quot;&#13;&#10;ELSEIF [PATIENT_TYPE] = 2 THEN &quot;Hospitalized&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
